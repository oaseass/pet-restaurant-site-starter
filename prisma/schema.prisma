generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  ACTIVE
  REMOVED_FROM_SOURCE
}

enum SyncStatus {
  SUCCESS
  SKIPPED
  FAILED
}

enum PlaceCategory {
  PET_RESTAURANT
  ANIMAL_HOSPITAL
  EMERGENCY_HOSPITAL
  VACCINATION
  REGISTRATION
  SURGERY
  TRAVEL
  FLIGHT
  SHIP
  GROOMING
  DAYCARE
  HOTEL
  TRAINING
  PET_SUPPLY
  PET_FOOD
  FUNERAL
  PHARMACY
  LOST_PET
  INSURANCE
  CHECKLIST
}

enum SourceType {
  OFFICIAL_DATA
  USER_REPORT
  OWNER_SUBMISSION
  MANUAL_DATA
  ADMIN_VERIFIED
}

enum SyncSource {
  FOODSAFETY_PET_RESTAURANT
  LOCALDATA_ANIMAL_HOSPITAL
  LOCALDATA_GROOMING
  LOCALDATA_DAYCARE
  LOCALDATA_FUNERAL
  LOCALDATA_PHARMACY
  ANIMAL_CLINIC_FEE
  AIRLINE_OFFICIAL
  SHIP_MANUAL
  MANUAL_GUIDE
  PLATFORM_DAILY_SYNC
}

enum LostPetStatus {
  PENDING
  APPROVED
  FOUND
  CLOSED
}

enum ReportStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewTargetType {
  RESTAURANT
  PLACE
}

enum ReviewPetType {
  DOG
  CAT
  BOTH
  OTHER
}

enum ReviewPetSize {
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

enum ReviewPolicyAnswer {
  YES
  NO
  UNKNOWN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BusinessCheckType {
  PHONE_CALL
  VISIT
}

enum BusinessCheckResult {
  CONFIRMED_OPEN
  NO_ANSWER
  NEEDS_UPDATE
  CLOSED_OR_UNAVAILABLE
}

model Restaurant {
  id                 String           @id @default(cuid())
  sourceKey          String           @unique
  name               String
  businessType       String
  sido               String
  sigungu            String?
  eupmyeondong       String?
  address            String
  normalizedAddress  String
  lat                Float?
  lng                Float?
  officialRegistered Boolean          @default(true)
  status             RestaurantStatus @default(ACTIVE)
  sourceUrl          String
  dataUpdatedAt      DateTime
  firstSeenAt        DateTime         @default(now())
  lastSeenAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([sido])
  @@index([sigungu])
  @@index([businessType])
  @@index([status])
  @@index([name])
}

model Place {
  id              String        @id @default(cuid())
  category        PlaceCategory
  name            String
  normalizedName  String
  sido            String?
  sigungu         String?
  eupmyeondong    String?
  address         String?
  roadAddress     String?
  lat             Float?
  lng             Float?
  phone           String?
  businessStatus  String?
  sourceType      SourceType
  sourceName      SyncSource?
  sourceUrl       String?
  sourceId        String?
  sourceUpdatedAt DateTime?
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  ownerVerified   Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile         PlaceProfile?
  priceReports    PriceReport[]
  businessClaims  BusinessClaim[]

  @@index([category, isActive])
  @@index([sido, sigungu])
  @@index([normalizedName])
  @@index([sourceType])
  @@unique([sourceType, sourceId])
}

model PlaceProfile {
  id               String   @id @default(cuid())
  placeId          String   @unique
  description      String?
  openingHours     String?
  priceText        String?
  serviceTags      Json?
  parkingAvailable Boolean?
  reservationUrl   String?
  largeDogAllowed  Boolean?
  catAllowed       Boolean?
  indoorAllowed    Boolean?
  outdoorAllowed   Boolean?
  cageRequired     Boolean?
  leashRequired    Boolean?
  ownerUpdatedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model Guide {
  id                String        @id @default(cuid())
  category          PlaceCategory
  title             String
  slug              String        @unique
  summary           String
  content           String
  sourceNote        String?
  sourceUrls        Json?
  reviewedAt        DateTime?
  medicalDisclaimer Boolean       @default(false)
  legalDisclaimer   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([category])
}

model LostPet {
  id            String        @id @default(cuid())
  petName       String
  animalType    String
  breed         String?
  sex           String?
  age           String?
  photoUrls     Json?
  lostSido      String
  lostSigungu   String?
  lostAddress   String
  lostLat       Float?
  lostLng       Float?
  lostAt        DateTime
  description   String
  rewardAmount  Int?
  contactToken  String        @unique
  contactMasked String
  status        LostPetStatus @default(PENDING)
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reports LostPetReport[]

  @@index([lostSido, lostSigungu])
  @@index([status, createdAt])
}

model LostPetReport {
  id                    String       @id @default(cuid())
  lostPetId             String
  reporterName          String
  reporterContactMasked String
  seenAt                DateTime
  seenAddress           String
  seenLat               Float?
  seenLng               Float?
  description           String
  status                ReportStatus @default(PENDING)
  createdAt             DateTime     @default(now())

  lostPet LostPet @relation(fields: [lostPetId], references: [id], onDelete: Cascade)

  @@index([lostPetId, createdAt])
}

model PriceReport {
  id              String       @id @default(cuid())
  placeId         String?
  category        PlaceCategory
  itemName        String
  price           Int?
  receiptImageUrl String?
  reportNote      String?
  sourceType      SourceType
  status          ReportStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([category, status])
}

model BusinessClaim {
  id                               String      @id @default(cuid())
  placeId                          String?
  businessName                     String
  ownerName                        String
  phoneMasked                      String
  businessRegistrationNumberMasked String
  requestType                      String
  status                           ClaimStatus @default(PENDING)
  submittedAt                      DateTime    @default(now())
  approvedAt                       DateTime?
  createdAt                        DateTime    @default(now())

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
}

model Review {
  id                String             @id @default(cuid())
  targetType        ReviewTargetType
  targetId          String
  ratingOverall     Int
  ratingPetFriendly Int
  ratingCleanliness Int?
  ratingStaff       Int?
  ratingParking     Int?
  petType           ReviewPetType
  petSize           ReviewPetSize
  visitDate         DateTime
  title             String
  body              String
  indoorAllowed     ReviewPolicyAnswer @default(UNKNOWN)
  outdoorAllowed    ReviewPolicyAnswer @default(UNKNOWN)
  largeDogAllowed   ReviewPolicyAnswer @default(UNKNOWN)
  carrierRequired   ReviewPolicyAnswer @default(UNKNOWN)
  leashRequired     ReviewPolicyAnswer @default(UNKNOWN)
  images            String[]           @default([])
  status            ReviewStatus       @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([targetType, targetId, status, createdAt])
  @@index([status, createdAt])
}

model BusinessCheck {
  id        String              @id @default(cuid())
  targetType ReviewTargetType
  targetId   String
  checkType  BusinessCheckType
  result     BusinessCheckResult
  checkedAt  DateTime
  note       String?
  status     ReportStatus       @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([targetType, targetId, status, checkedAt])
  @@index([status, createdAt])
}

model SyncLog {
  id            String     @id @default(cuid())
  source        SyncSource
  mode          String     @default("scheduled")
  status        SyncStatus
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  totalCount    Int        @default(0)
  addedCount    Int        @default(0)
  updatedCount  Int        @default(0)
  removedCount  Int        @default(0)
  skippedReason String?
  errorMessage  String?
  sourceUrl     String?
  message       String?

  @@index([source, status, finishedAt])
}

model SyncLock {
  id        String     @id @default(cuid())
  source    SyncSource @unique
  lockedAt  DateTime   @default(now())
  expiresAt DateTime
  status    String     @default("LOCKED")

  @@index([source, expiresAt])
}
