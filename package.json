    "next": "15.5.15",
    "next-auth": "^4.24.14",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "xlsx": "0.18.5",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.13",
