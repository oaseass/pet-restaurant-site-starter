{
  "name": "pet-restaurant-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/export-public-data.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "export:public-data": "tsx scripts/export-public-data.ts",
    "sync:local": "tsx scripts/sync-local.ts",
    "sync:local:force": "tsx scripts/sync-local.ts --force",
    "geocode:restaurants": "tsx scripts/geocode-restaurants.ts",
    "geocode:places": "tsx scripts/geocode-places.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cheerio": "1.2.0",
    "clsx": "2.1.1",
