# PostgreSQL. Example: postgresql://user:password@localhost:5432/pet_restaurants
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pet_restaurants"

# Daily cron/manual sync protection. Make this long and random.
CRON_SECRET="change-this-long-random-secret"

# Official page. Do not call this per user request; cron only.
FOODSAFETY_SOURCE_URL="https://www.foodsafetykorea.go.kr/portal/petKorea.do"
SYNC_MIN_HOURS="23"

# Optional, displayed in User-Agent for polite crawling.
SOURCE_CONTACT_EMAIL="admin@example.com"

# Public site URL for metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
